@{
    ViewBag.Title = "About Me";
    Layout = "~/Views/Shared/Mainlayout.cshtml";
}

<link rel="stylesheet" href="~/Content/bootstrap.min.css" />
<link rel="stylesheet" href="~/Content/BookStore/HomePage.css" />
<link rel="stylesheet" href="~/Content/BookStore/SOFM.css" />

<link href="https://fonts.googleapis.com/css2?family=Exo+2:wght@500;600;700;800;900&display=swap"
      rel="stylesheet">

<style>
    /* =========================
       ABOUT PAGE
       ========================= */

    .about-page {
        font-family: 'Exo 2', sans-serif;
        background: #f5f3ec;
        min-height: 100vh;
        padding-bottom: 70px;
    }

    /* =========================
       BANNER
       ========================= */

    .about-hero {
        position: relative;
        min-height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        background: radial-gradient(circle at 20% 30%, rgba(56,189,248,.25), transparent 30%), radial-gradient(circle at 80% 70%, rgba(247,107,28,.20), transparent 30%), linear-gradient(135deg, #0b0f2e 0%, #141a3d 55%, #1e6fea 100%);
    }

        .about-hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 50%;
            left: -180px;
            top: -220px;
        }

        .about-hero::after {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
            right: -170px;
            bottom: -220px;
        }

    .about-hero-content {
        position: relative;
        z-index: 2;
    }

  

    .about-hero h1 {
        margin: 0;
        font-size: 55px;
        font-weight: 900;
        letter-spacing: 4px;
        color: white;
        text-shadow: 0 5px 20px rgba(0,0,0,.35);
    }

        .about-hero h1 span {
            background: linear-gradient( 90deg, #38bdf8, #ffffff, #fdbb2d );
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

    .about-hero p {
        margin-top: 12px;
        color: #cbd5e1;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 2px;
    }

    /* =========================
       CONTENT
       ========================= */

    .about-container {
        max-width: 1050px;
        margin: -45px auto 0;
        position: relative;
        z-index: 5;
        padding: 0 20px;
    }

    .about-card {
        background: white;
        border-radius: 24px;
        padding: 45px;
        box-shadow: 0 20px 50px rgba(11,15,46,.15);
        border: 1px solid rgba(11,15,46,.06);
    }

    /* =========================
       TITLE
       ========================= */

    .about-title {
        text-align: center;
        margin-bottom: 35px;
    }

        .about-title h2 {
            margin: 0;
            color: #0b0f2e;
            font-size: 32px;
            font-weight: 900;
        }

        .about-title .line {
            width: 70px;
            height: 4px;
            margin: 12px auto 0;
            border-radius: 10px;
            background: linear-gradient( 90deg, #1e6fea, #38bdf8 );
        }

    /* =========================
       PROFILE
       ========================= */

    .about-profile {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 40px;
        align-items: center;
    }

    .about-avatar {
        width: 190px;
        height: 190px;
        margin: auto;
        border-radius: 20%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, #1e6fea, #38bdf8 );
        box-shadow: 0 15px 35px rgba(30,111,234,.25);
        color: white;
        font-size: 70px;
        font-weight: 900;
        font-style: italic;
    }
    .about-avatar {
        width: 150px;
        height: 160px;
        font-size: 55px;
    }

    .about-avatar {
        overflow: hidden;
    }

        .about-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .about-info h3 {
        margin-top: 0;
        font-size: 28px;
        font-weight: 900;
        color: #0b0f2e;
    }

        .about-info h3 span {
            color: #1e6fea;
        }

    .about-info p {
        color: #64748b;
        font-size: 16px;
        line-height: 1.8;
        margin-bottom: 12px;
    }

    .about-info strong {
        color: #0b0f2e;
    }

    /* =========================
       INFO BOX
       ========================= */

    .about-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 40px;
    }

    .about-detail-box {
        padding: 25px 20px;
        text-align: center;
        background: #f8fafc;
        border-radius: 18px;
        border: 1px solid #e2e8f0;
        transition: .3s;
    }

        .about-detail-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(11,15,46,.10);
        }

    .about-detail-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, #1e6fea, #38bdf8 );
        color: white;
        font-size: 22px;
    }

    .about-detail-box h4 {
        margin: 8px 0;
        color: #0b0f2e;
        font-size: 18px;
        font-weight: 800;
    }

    .about-detail-box p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    /* =========================
       ABOUT BS
       ========================= */

    .about-bs {
        margin-top: 45px;
        padding: 30px;
        border-radius: 20px;
        background: linear-gradient( 135deg, #0b0f2e, #141a3d );
        color: white;
    }

        .about-bs h3 {
            margin-top: 0;
            font-size: 25px;
            font-weight: 900;
        }

        .about-bs p {
            color: #cbd5e1;
            line-height: 1.8;
            margin-bottom: 0;
        }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 768px) {

        .about-hero {
            min-height: 300px;
        }

            .about-hero h1 {
                font-size: 38px;
            }

        .about-profile {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .about-details {
            grid-template-columns: 1fr;
        }

        .about-card {
            padding: 30px 20px;
        }

        
    }
</style>


<div class="about-page">

    <!-- =========================
         BANNER
         ========================= -->

    <section class="about-hero">

        <div class="about-hero-content">

            <div class="about-avatar">
                <img src="~/image/logoBS.png" />
            </div>

            <h1>
                WELCOME TO <span>BS</span>
            </h1>

            <p>
                BOOK STORE • ABOUT ME
            </p>

        </div>

    </section>


    <!-- =========================
         CONTENT
         ========================= -->

    <div class="about-container">

        <div class="about-card">

            <div class="about-title">

                <h2>Giới thiệu</h2>

                <div class="line"></div>

            </div>


            <div class="about-profile">

                <!-- Avatar -->
                <div class="about-avatar">
                    <img src="~/image/myself.jpg" alt="Lê Bảo Phước Toàn" />
                </div>

                <!-- Information -->
                <div class="about-info">

                    <h3>
                        Xin chào, Em là
                        <span>Lê Bảo Phước Toàn</span>
                    </h3>

                    <p>
                        Em là người thực hiện và phát triển website
                        <strong>BS - Book Store</strong>.
                        Đây là một dự án được xây dựng nhằm mô phỏng
                        hệ thống bán sách trực tuyến, hỗ trợ khách hàng
                        tìm kiếm, lựa chọn và đặt mua sách một cách
                        thuận tiện.
                    </p>

                    <p>
                        Trong quá trình thực hiện dự án, em đã tìm hiểu
                        và áp dụng các kiến thức về lập trình web,
                        cơ sở dữ liệu, thiết kế giao diện và xây dựng
                        các chức năng quản lý cho hệ thống.
                    </p>

                </div>

            </div>


            <!-- =========================
                 DETAILS
                 ========================= -->

            <div class="about-details">

                <div class="about-detail-box">

                    <div class="about-detail-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <h4>Người thực hiện</h4>

                    <p>Lê Bảo Phước Toàn</p>

                </div>


                <div class="about-detail-box">

                    <div class="about-detail-icon">
                        <i class="fa-solid fa-code"></i>
                    </div>

                    <h4>Dự án</h4>

                    <p>BS - Book Store</p>

                </div>


                <div class="about-detail-box">

                    <div class="about-detail-icon">
                        <i class="fa-solid fa-book"></i>
                    </div>

                    <h4>Lĩnh vực</h4>

                    <p>Bán sách trực tuyến</p>

                </div>

            </div>


            <!-- =========================
                 ABOUT BS
                 ========================= -->

            <div class="about-bs">

                <h3>
                    <i class="fa-solid fa-book-open"></i>
                    Về BS - Book Store
                </h3>

                <p>
                    BS là website bán sách trực tuyến được xây dựng
                    với mục tiêu mang đến một không gian mua sắm sách
                    đơn giản, trực quan và thuận tiện. Hệ thống hỗ trợ
                    các chức năng như xem sách, tra cứu sách, xem chi tiết,
                    thêm sách vào giỏ hàng, đặt hàng và theo dõi đơn hàng.
                    Bên cạnh đó, quản trị viên có thể quản lý sách,
                    thể loại, tài khoản và đơn hàng.
                </p>

            </div>

        </div>

    </div>

</div>